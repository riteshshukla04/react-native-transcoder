{
  "profile": "mobile-core",
  "dependencies": [
    {
      "name": "ffmpeg",
      "version": "7.1.1",
      "source": "https://ffmpeg.org/releases/ffmpeg-7.1.1.tar.xz",
      "sha256": "733984395e0dbbe5c046abda2dc49a5544e7e0e1e2366bba849222ae9e3a03b1",
      "license": "LGPL-2.1-or-later",
      "linkage": "shared",
      "configureFlags": [
        "--disable-gpl",
        "--disable-nonfree",
        "--enable-shared",
        "--disable-static",
        "--enable-libmp3lame",
        "--enable-libopus",
        "--enable-libvorbis"
      ],
      "patches": [],
      "components": {
        "demuxers": "wav,aiff,caf,mov,mp3,flac,ogg,matroska,aac,w64,pcm_s16le,pcm_f32le",
        "muxers": "wav,aiff,caf,ipod,mp4,mp3,flac,ogg,matroska,adts,w64",
        "decoders": "pcm_*,aac,mp3,flac,alac,vorbis,opus",
        "encoders": "pcm_*,aac,flac,alac,libmp3lame,libopus,libvorbis"
      },
      "architectures": {
        "android": [
          "arm64-v8a",
          "armeabi-v7a",
          "x86",
          "x86_64"
        ],
        "ios": [
          "device arm64",
          "simulator arm64",
          "simulator x86_64"
        ]
      }
    },
    {
      "name": "lame",
      "version": "3.100",
      "source": "https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz",
      "sha256": "ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e",
      "license": "LGPL-2.0-or-later",
      "linkage": "static-into-ffmpeg",
      "configureFlags": [
        "--disable-shared",
        "--enable-static",
        "--with-pic",
        "--disable-frontend",
        "--disable-decoder",
        "--disable-analyzer-hooks"
      ],
      "patches": [
        "drop lame_init_old from include/libmp3lame.sym; 3.100 exports a symbol it no longer defines"
      ],
      "components": {
        "encoders": "libmp3lame"
      }
    },
    {
      "name": "opus",
      "version": "1.5.2",
      "source": "https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz",
      "sha256": "65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1",
      "license": "BSD-3-Clause",
      "linkage": "static-into-ffmpeg",
      "configureFlags": [
        "--disable-shared",
        "--enable-static",
        "--with-pic",
        "--disable-doc",
        "--disable-extra-programs"
      ],
      "patches": [],
      "components": {
        "encoders": "libopus"
      }
    },
    {
      "name": "libvorbis",
      "version": "1.3.7",
      "source": "https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz",
      "sha256": "0e982409a9c3fc82ee06e08205b1355e5c6aa4c36bca58146ef399621b0ce5ab",
      "license": "BSD-3-Clause",
      "linkage": "static-into-ffmpeg",
      "configureFlags": [
        "--disable-shared",
        "--enable-static",
        "--with-pic",
        "--disable-oggtest"
      ],
      "patches": [
        "strip -mno-ieee-fp and -force_cpusubtype_ALL from configure; current clang and ld reject both"
      ],
      "components": {
        "encoders": "libvorbis"
      }
    },
    {
      "name": "libogg",
      "version": "1.3.5",
      "source": "https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz",
      "sha256": "0eb4b4b9420a0f51db142ba3f9c64b333f826532dc0f48c6410ae51f4799b664",
      "license": "BSD-3-Clause",
      "linkage": "static-into-ffmpeg",
      "configureFlags": [
        "--disable-shared",
        "--enable-static",
        "--with-pic"
      ],
      "patches": [],
      "components": {
        "note": "libvorbis dependency only; the Ogg muxer itself is native FFmpeg"
      }
    }
  ]
}
