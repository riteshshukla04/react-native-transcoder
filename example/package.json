{
  "name": "transcoder-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix && prettier --write \"**/*.{js,ts,tsx}\"",
    "start": "react-native start",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" --max-warnings=0 -f @jamesacarr/github-actions && prettier --check \"**/*.{js,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:harness": "react-native-harness",
    "bundle-install": "bundle install",
    "pods": "bundle install && cd ios && bundle exec pod install",
    "build:android-release": "cd android && ./gradlew assembleRelease --no-daemon"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.3",
    "@react-native/new-app-screen": "0.85.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-transcoder": "*",
    "react-native-nitro-modules": "0.37.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native-harness/jest": "1.4.1",
    "@react-native-harness/platform-android": "1.4.1",
    "@react-native-harness/platform-apple": "1.4.1",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "react-native-harness": "1.4.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}