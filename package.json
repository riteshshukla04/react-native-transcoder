{
  "name": "react-native-transcoder-monorepo",
  "private": true,
  "version": "0.1.0",
  "repository": "https://github.com/riteshshukla04/react-native-transcoder.git",
  "workspaces": [
    "packages/react-native-transcoder",
    "example"
  ],
  "scripts": {
    "postinstall": "bun transcoder build",
    "bootstrap": "bun i && bun run build && cd example && bundle install && bun pods",
    "build": "bun transcoder build",
    "typecheck": "bun --filter=\"**\" typecheck",
    "lint": "bun --filter=\"**\" lint",
    "lint-ci": "bun --filter=\"**\" lint-ci",
    "lint-cpp": "./scripts/clang-format.sh",
    "tidy-cpp": "./scripts/clang-tidy.sh",
    "specs": "bun transcoder specs",
    "transcoder": "bun --cwd packages/react-native-transcoder",
    "example": "bun --cwd example"
  },
  "devDependencies": {
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@types/bun": "^1.3.14"
  },
  "overrides": {
    "jest": "^30.2.0"
  }
}